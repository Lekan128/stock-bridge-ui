# Netlify routing. First match wins, so order matters.

# The marketplace's old searches on / move under /marketplace, query kept (LANDING_PAGE_PLAN.md, step 2).
/  q=:q                      /marketplace?q=:q                    301
/  categoryId=:categoryId    /marketplace?categoryId=:categoryId  301

# The Procurepaddy landing page: prerendered by scripts/prerender.mjs. Forced (!), because index.html
# (the app shell) would otherwise shadow it at /.
/  /landing.html  200!

# The founding offer with no navigation, for ads and outreach (LANDING_PAGE_PLAN.md, rule 6).
# Prerendered too; noindex and canonical to /.
/founding   /founding.html  200!
/founding/  /founding.html  200!

# The marketplace's old addresses. Query strings pass through, which Monnify's return relies on.
/product/*             /marketplace/product/:splat             301
/seller/*              /marketplace/seller/:splat              301
/cart                  /marketplace/cart                       301
/checkout              /marketplace/checkout                   301
/checkout/*            /marketplace/checkout/:splat            301
/order-confirmation/*  /marketplace/order-confirmation/:splat  301

# Everything else is the app.
/*    /index.html   200
